# Names only. NEVER put real values here. Real values go in Vercel -> Settings -> Environment Variables (and a local .env that git ignores).
# --- Supabase ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
# MASTER KEY: server only (api/, worker/). Never in app/, android/, features/. check.ts blocks it.
SUPABASE_SERVICE_ROLE_KEY=
OWNER_EMAIL=
# --- Browser app (Vite exposes only VITE_ names to the page; these two are safe to expose) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# --- AI models (server only) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# --- Our own secrets (make long random strings) ---
CRON_SECRET=
# 32+ random characters; server hashes device tokens as SHA-256(pepper + ":" + token)
DEVICE_TOKEN_PEPPER=
# --- Worker (optional) ---
WORKER_ID=
LOG_LEVEL=
